# ============================================================================
# Variables de Entorno para Despliegue (Vercel Frontend + Render Backend / Docker)
# ============================================================================

# --- Backend (API Nodes & DuckDB Data Nodes) ---
REDIS_HOST=localhost
REDIS_PORT=6379
SINGLE_PROCESS_CLUSTER=1
API_NODE_1_URL=http://localhost:8000
API_NODE_2_URL=http://localhost:8001
DATA_NODE_1_URL=http://localhost:8011
DATA_NODE_2_URL=http://localhost:8012

# --- Frontend (Vercel / Astro / React) ---
# URL base del Backend en Render (por defecto apunta a https://lmu-paddock-dashboard.onrender.com)
PUBLIC_BACKEND_URL=https://lmu-paddock-dashboard.onrender.com

# Opcional: Sobreescribir individualmente cada nodo de API si están en dominios distintos
PUBLIC_API_NODE_1_URL=
PUBLIC_API_NODE_2_URL=
