# ============================================================================
# Variables de Entorno para Despliegue (Docker Compose / VPS / Railway / Cloud)
# ============================================================================

# --- Backend (API Nodes & DuckDB Data Nodes) ---
REDIS_HOST=localhost
REDIS_PORT=6379
API_NODE_1_URL=http://localhost:8000
API_NODE_2_URL=http://localhost:8001
DATA_NODE_1_URL=http://localhost:8011
DATA_NODE_2_URL=http://localhost:8012

# --- Frontend (Astro / React) ---
# Si se dejan vacías, el frontend detecta automáticamente el hostname/IP del servidor
# desde donde se carga la página (ej. http://<IP_DEL_VPS>:8000/api/v1 y :8001/api/v1).
# Si despliegas en Railway / Cloudflare Pages con dominios separados, colócalos aquí:
PUBLIC_API_NODE_1_URL=
PUBLIC_API_NODE_2_URL=
